{
  "format_version": "0.0.1",
  "name": "wxencircle",
  "description": "[WindowX/玩家自用] 绕中心公转",
  "permission_level": "any",
  "args": [
    {
      "name": "id",
      "type": "str"
    },
    {
      "name": "rx",
      "type": "float",
      "default": 60.0
    },
    {
      "name": "ry",
      "type": "float",
      "default": 40.0
    },
    {
      "name": "speed",
      "type": "float",
      "default": 1.0
    },
    {
      "name": "deg",
      "type": "float",
      "description": "总角度",
      "default": 360.0
    },
    {
      "name": "ease",
      "type": "str",
      "description": "可选: linear,quad,quadout,quadinout,cubic,cubicout,cubicinout,quart,quartout,quartinout,quint,quintout,quintinout,sine,sineout,sineinout,expo,expoout,expoinout,circ,circout,circinout,bounce,bounceout,bounceinout,elastic,elasticout,elasticinout,back,backout,backinout,spring,wave,jump,delay,rush,slowmo,faststart,stutter,glitch,packetloss,freeze,overshoot,snap,jitter,step3,step5,step8",
      "default": "linear"
    }
  ]
}
