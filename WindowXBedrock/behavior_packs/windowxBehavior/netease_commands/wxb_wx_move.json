{
  "format_version": "0.0.1",
  "name": "wxmove",
  "description": "[WindowX/玩家自用] 平滑移动窗口",
  "permission_level": "any",
  "args": [
    {
      "name": "id",
      "type": "str"
    },
    {
      "name": "x",
      "type": "str",
      "description": "目标 X，绝对/r相对/p百分比"
    },
    {
      "name": "y",
      "type": "str",
      "description": "目标 Y，绝对/r相对/p百分比"
    },
    {
      "name": "speed",
      "type": "float",
      "description": "速度倍率",
      "default": 1.0
    },
    {
      "name": "ease",
      "type": "str",
      "description": "缓动曲线 | 可选: linear,quad,quadout,quadinout,cubic,cubicout,cubicinout,quart,quartout,quartinout,quint,quintout,quintinout,sine,sineout,sineinout,expo,expoout,expoinout,circ,circout,circinout,bounce,bounceout,bounceinout,elastic,elasticout,elasticinout,back,backout,backinout,spring,wave,jump,delay,rush,slowmo,faststart,stutter,glitch,packetloss,freeze,overshoot,snap,jitter,step3,step5,step8",
      "default": "linear"
    }
  ]
}
